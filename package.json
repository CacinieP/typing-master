{
  "name": "typing-master",
  "version": "1.3.0",
  "description": "多语言打字练习 - Multi-language typing practice (FR/ES/IT/PT/RU/DE/JA)",
  "main": "main.js",
  "author": "CacinieP",
  "license": "AGPL-3.0-only",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.typingmaster.app",
    "productName": "Typing Master",
    "directories": {
      "output": "dist"
    },
    "icon": "build/icon.png",
    "afterSign": "build/notarize.js",
    "files": [
      "index.html",
      "main.js",
      "css/**",
      "js/**",
      "words/**",
      "manuals/**",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "25.1.8"
  }
}
