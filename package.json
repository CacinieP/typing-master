{
  "name": "typing-master",
  "version": "1.0.0",
  "description": "多语言打字练习 - Multi-language typing practice (FR/ES/IT/PT/RU/JA)",
  "main": "main.js",
  "author": "Typing Master",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.typingmaster.app",
    "productName": "Typing Master",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "css/**",
      "js/**",
      "words/**",
      "manuals/**",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
